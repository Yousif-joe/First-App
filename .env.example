# Copy this file to .env and fill in real values.
# See README.md for full setup instructions.

# --- Database (SQLite via Prisma) ---
DATABASE_URL="file:./dev.db"

# --- Anthropic (Claude) ---
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- SMTP email (Nodemailer) ---
# Used to email case summaries/escalations to SUPPORT_LEAD_EMAIL.
# If on Microsoft 365, see the README note about enabling SMTP AUTH.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Who receives case summary/escalation emails. Defaults to
# yousif.jawad@alsamaproject.com in code if left unset.
SUPPORT_LEAD_EMAIL=yousif.jawad@alsamaproject.com

# --- Admin login gate ---
# JSON array of the 5 PowerSchool admins allowed to use the portal.
ADMIN_LIST=[{"name":"Jane Doe","email":"jane.doe@alsamaproject.com"},{"name":"John Smith","email":"john.smith@alsamaproject.com"}]

# Optional: require a shared passcode at login, on top of picking a name.
# Leave blank/unset to skip this (login is then just "pick your name").
APP_PASSCODE=

# Used to sign the login session cookie. Set this to a long random string
# in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
